{
  "format": "dsh-dream-skin/pack",
  "version": 1,
  "manifest": {
    "id": "apple-light",
    "name": "Apple Light",
    "nameZh": "苹果浅色",
    "author": "Wildchiken",
    "version": "1.0.0",
    "description": "macOS 浅色外观：系统灰底、系统蓝、几乎纯白的卡片。",
    "colorScheme": "light",
    "accent": "#0071e3",
    "tokens": {
      "--dsw-alias-bg-base": "#f5f5f7",
      "--dsw-alias-bg-layer-1": "rgba(255, 255, 255, 0.66)",

      "--dsw-alias-file-diff-deleted-bg": "rgba(215, 0, 21, 0.19)",
      "--dsw-alias-file-diff-deleted-gutter": "rgba(215, 0, 21, 0.24)",
      "--dsw-alias-file-diff-deleted-marker": "#d70015",
      "--dsw-alias-state-business-primary": "#0071e3",

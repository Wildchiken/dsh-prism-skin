      "--dsw-alias-bg-module-platform": "rgba(236, 236, 240, 0.8)",
      "--dsw-alias-bg-overlay": "rgba(255, 255, 255, 0.94)",
      "--dsw-alias-bg-skeleton": "rgba(29, 29, 31, 0.05)",
